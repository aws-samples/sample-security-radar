{
  "name": "security-radar-ui",
  "version": "1.6.20",
  "license": "MIT-0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-chunks.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "json2ts -i ../schemas/site-data.schema.json -o src/types/site-data.ts --no-additionalProperties --no-unknownAny",
    "a11y": "node scripts/a11y.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "mutate": "node scripts/mutate.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
