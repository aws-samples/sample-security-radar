    "Ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_reviews_total",
        "code_reviews_24h",
        "scans_total",
        "findings_submitted",
        "issues",
        "patches"
      ],
      "properties": {
        "code_reviews_total": {
          "type": "integer",
          "minimum": 0
