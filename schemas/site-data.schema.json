        "findings_submitted": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "integer",
          "minimum": 0
        },
        "patches": {
          "type": "integer",
          "minimum": 0
        },
        "cost": {
          "description": "Per-day spend of the AWS services the radar drives (Cost Explorer, refreshed every few hours). null until the first read.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fetched_at",
                "days",
                "total_usd"
              ],
              "properties": {
                "fetched_at": {
                  "$ref": "#/$defs/Timestamp"
                },
                "days": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CostDay"
                  }
                },
                "total_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Last read failed (numbers are from fetched_at)."
                }
              }
            }
          ]
        }
      }
    },
    "CostDay": {
      "type": "object",
      "additionalProperties": false,
