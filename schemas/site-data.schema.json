        "version",
        "file",
        "line"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ContinuumTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "name",
        "description",
        "prefix",
        "inventory"
      ],
      "properties": {
        "target_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "inventory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryEntry"
          }
        },
        "uploaded_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "s3",
            "github",
            "gitlab",
            "none"
          ],
          "description": "The ONE Continuum environment that validates this target (src/radar/targets.py CHANNEL); none = Security Agent only"
        },
        "channel_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the code lives for that channel (repository URL); null for s3 / none"
        }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
