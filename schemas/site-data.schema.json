        "status",
        "detail"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "service": {
          "enum": [
            "security_agent",
            "continuum",
            "radar"
          ]
        },
        "status": {
          "enum": [
            "live",
            "wired",
            "not_applicable",
            "needs_user"
          ]
        },
        "detail": {
          "type": "string"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ContinuumRecent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
