      "description": "'In your environment': what AWS Continuum + AWS Security Agent did for this event."
    },
    "ContinuumResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "region",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "console_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "InventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
